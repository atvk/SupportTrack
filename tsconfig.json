{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
  "@/*": ["./*"]
}
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/components/CopyButton.jsx",
    "src/app/Copy/page.tsx",
    "src/app/edit/page.jsx",
    "src/components/FormTest.jsx",
    "src/app/edit-test/page.jsx",
    "src/app/form/page.tsx",
    "src/components/EditButton.tsx",
    "src/app/users/page.tsx",
    "src/app/users/[id]/page.jsx",
    "src/app/page.tsx",
    "src/components/TableListings.tsx",
    ".next/dev/types/**/*.ts",
    "next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"

  ],
  "exclude": [
    "node_modules"
  ]
}
